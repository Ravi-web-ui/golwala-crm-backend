generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  // Connection pool settings for high concurrency
  // These are applied via the connection string
}

model AdminUser {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  email      String   @unique @db.VarChar(150)
  password   String   @db.VarChar(255)
  phone      String?  @db.VarChar(20)
  role       Role     @default(admin)
  createdAt  DateTime @default(now()) @map("created_at")

  leads            Lead[]       @relation("AssignedLeads")
  filters          Filter[]
  permissions      Permission?
  programAssignments ProgramAssignment[]
  activities       Activity[]
  followUps        FollowUp[]
  callLogs         CallLog[]
  mediaUploads     MediaLibrary[]

  @@map("admin_users")
}

model Permission {
  id                              Int      @id @default(autoincrement())
  adminId                         Int      @unique @map("admin_id")
  canViewLeads                    Boolean  @default(true)  @map("can_view_leads")
  canEditLeads                    Boolean  @default(true)  @map("can_edit_leads")
  canDeleteLeads                  Boolean  @default(false) @map("can_delete_leads")
  canExportLeads                  Boolean  @default(false) @map("can_export_leads")
  canViewReports                  Boolean  @default(true)  @map("can_view_reports")
  canManageFilters                Boolean  @default(true)  @map("can_manage_filters")
  canReceiveStudentNotifications  Boolean  @default(false) @map("can_receive_student_notifications")
  updatedAt                       DateTime @updatedAt      @map("updated_at")

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("permissions")
}

// Manager → programs mapping for auto-routing
model ProgramAssignment {
  id       Int    @id @default(autoincrement())
  adminId  Int    @map("admin_id")
  program  String @db.VarChar(255)

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, program])
  @@map("program_assignments")
}

model Lead {
  id           Int        @id @default(autoincrement())
  fullName     String     @map("full_name")     @db.VarChar(150)
  countryCode  String     @default("+91") @map("country_code") @db.VarChar(10)
  phone        String     @db.VarChar(20)
  email        String     @db.VarChar(150)
  city         String?    @db.VarChar(100)
  state        String?    @db.VarChar(100)
  programLevel String?    @map("program_level") @db.VarChar(50)
  program      String?    @db.VarChar(255)
  institute    String?    @db.VarChar(150)
  branch       String?    @db.VarChar(150)
  hearAbout    String?    @map("hear_about")    @db.VarChar(100)
  status       String     @default("new")
  assignedTo   Int?       @map("assigned_to")
  notes        String?    @db.Text
  utmSource    String?    @map("utm_source")    @db.VarChar(150)
  utmMedium    String?    @map("utm_medium")    @db.VarChar(150)
  utmCampaign  String?    @map("utm_campaign")  @db.VarChar(150)
  utmTerm      String?    @map("utm_term")      @db.VarChar(150)
  utmContent   String?    @map("utm_content")   @db.VarChar(150)
  utmName      String?    @map("utm_name")      @db.VarChar(150)
  formSource   String?    @map("form_source")   @db.VarChar(255)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt      @map("updated_at")

  assignedAdmin AdminUser? @relation("AssignedLeads", fields: [assignedTo], references: [id])
  activities    Activity[]
  followUps     FollowUp[]
  callLogs      CallLog[]

  // Indexes for fast filtering with 10k+ leads
  @@index([status])
  @@index([assignedTo])
  @@index([createdAt])
  @@index([phone])
  @@index([programLevel])
  @@index([program])
  @@index([status, assignedTo])
  @@index([status, createdAt])
  @@map("leads")
}

model Activity {
  id        Int          @id @default(autoincrement())
  leadId    Int          @map("lead_id")
  adminId   Int          @map("admin_id")
  type      ActivityType
  note      String?      @db.Text
  createdAt DateTime     @default(now()) @map("created_at")

  lead  Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  admin AdminUser @relation(fields: [adminId], references: [id])

  @@index([leadId])
  @@index([createdAt])
  @@map("activities")
}

model FollowUp {
  id          Int            @id @default(autoincrement())
  leadId      Int            @map("lead_id")
  adminId     Int            @map("admin_id")
  scheduledAt DateTime       @map("scheduled_at")
  note        String?        @db.VarChar(500)
  status      FollowUpStatus @default(pending)
  createdAt   DateTime       @default(now()) @map("created_at")

  lead  Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  admin AdminUser @relation(fields: [adminId], references: [id])

  @@index([leadId])
  @@index([adminId, status, scheduledAt])
  @@map("follow_ups")
}

model CallLog {
  id        Int         @id @default(autoincrement())
  leadId    Int         @map("lead_id")
  adminId   Int         @map("admin_id")
  calledAt  DateTime    @map("called_at")
  duration  Int?        // minutes
  outcome   CallOutcome
  notes     String?     @db.VarChar(500)
  createdAt DateTime    @default(now()) @map("created_at")

  lead  Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  admin AdminUser @relation(fields: [adminId], references: [id])

  @@map("call_logs")
}

model Filter {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  createdBy    Int      @map("created_by")
  filterConfig Json     @map("filter_config")
  isShared     Boolean  @default(false) @map("is_shared")
  createdAt    DateTime @default(now()) @map("created_at")

  admin AdminUser @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("filters")
}

model ContactInquiry {
  id        Int      @id @default(autoincrement())
  fullName  String   @map("full_name")  @db.VarChar(150)
  phone     String?  @db.VarChar(20)
  email     String   @db.VarChar(150)
  program   String?  @db.VarChar(255)
  message   String   @db.Text
  status    String   @default("new")   @db.VarChar(50)
  createdAt DateTime @default(now())   @map("created_at")

  @@map("contact_inquiries")
}

model LeadStatusConfig {
  id        Int      @id @default(autoincrement())
  label     String   @db.VarChar(100)
  value     String   @unique @db.VarChar(100)
  color     String   @db.VarChar(50)
  stage     String   @default("active") @db.VarChar(20)
  order     Int      @default(0)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("lead_status_configs")
}

enum Role {
  super_admin
  admin
  manager
}

enum ActivityType {
  note
  call
  whatsapp
  email
  visit
  status_change
  follow_up
  lead_created
}

enum FollowUpStatus {
  pending
  done
  missed
}

enum CallOutcome {
  answered
  not_answered
  busy
  callback_requested
}

model Institute {
  id             Int      @id @default(autoincrement())
  name           String   @unique @db.VarChar(150)
  genioSubdomain String?  @map("genio_subdomain") @db.VarChar(100)
  genioCollegeId Int?     @map("genio_college_id")
  createdAt      DateTime @default(now()) @map("created_at")

  branches Branch[]

  @@map("institutes")
}

model Branch {
  id            Int      @id @default(autoincrement())
  instituteId   Int      @map("institute_id")
  name          String   @db.VarChar(150)
  genioBranchId Int?     @map("genio_branch_id")
  createdAt     DateTime @default(now()) @map("created_at")

  institute      Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  courseMappings CourseMapping[]

  @@unique([instituteId, name])
  @@map("branches")
}

model CourseMapping {
  id                    Int      @id @default(autoincrement())
  branchId              Int      @map("branch_id")
  ourCourseName         String   @map("our_course_name")         @db.VarChar(255)
  externalCourseName    String   @map("external_course_name")    @db.VarChar(255)
  genioCourseId         Int?     @map("genio_course_id")
  genioSpecializationId Int?     @map("genio_specialization_id")
  createdAt             DateTime @default(now()) @map("created_at")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("course_mappings")
}

// ── Student Admissions Models ──────────────────────────────────────────

model StudentAdmission {
  id                   Int      @id @default(autoincrement())
  applicationNo        String?  @unique @map("application_no") @db.VarChar(50)
  
  // Program Selection
  programCategory      String?  @map("program_category") @db.VarChar(100)
  programType          String?  @map("program_type") @db.VarChar(100)
  programName          String?  @map("program_name") @db.VarChar(255)
  
  // Personal Details
  surname              String   @db.VarChar(100)
  firstName            String   @map("first_name") @db.VarChar(100)
  fatherName           String   @map("father_name") @db.VarChar(100)
  motherName           String   @map("mother_name") @db.VarChar(100)
  surnameMr            String?  @map("surname_mr") @db.VarChar(100)
  firstNameMr          String?  @map("first_name_mr") @db.VarChar(100)
  fatherNameMr         String?  @map("father_name_mr") @db.VarChar(100)
  motherNameMr         String?  @map("mother_name_mr") @db.VarChar(100)
  nameAsPerAadhar      String   @map("name_as_per_aadhar") @db.VarChar(200)
  gender               String   @db.VarChar(20)
  aadharNo             String   @map("aadhar_no") @db.VarChar(12)
  maritalStatus        String   @map("marital_status") @db.VarChar(20)
  bloodGroup           String   @map("blood_group") @db.VarChar(5)
  dob                  DateTime
  placeBirthCity       String   @map("place_birth_city") @db.VarChar(100)
  placeBirthTehsil     String   @map("place_birth_tehsil") @db.VarChar(100)
  placeBirthState      String   @map("place_birth_state") @db.VarChar(100)
  placeBirthCountry    String   @default("India") @map("place_birth_country") @db.VarChar(100)
  nationality          String   @default("Indian") @db.VarChar(50)
  voterId              String?  @map("voter_id") @db.VarChar(20)
  category             String   @db.VarChar(30)
  religion             String   @db.VarChar(30)
  caste                String   @db.VarChar(100)
  subCaste             String?  @map("sub_caste") @db.VarChar(100)
  motherTongue         String   @map("mother_tongue") @db.VarChar(50)
  differentlyAbled     String   @default("No") @map("differently_abled") @db.VarChar(5)
  stream               String   @db.VarChar(50)
  abcId                String   @map("abc_id") @db.VarChar(50)
  prnErnNo             String?  @map("prn_ern_no") @db.VarChar(50)
  employmentStatus     String?  @default("No") @map("employment_status") @db.VarChar(5)
  
  // Address - Correspondence
  corrAddress          String   @map("corr_address") @db.Text
  corrState            String   @map("corr_state") @db.VarChar(100)
  corrDistrict         String   @map("corr_district") @db.VarChar(100)
  corrPincode          String   @map("corr_pincode") @db.VarChar(6)
  corrCity             String   @map("corr_city") @db.VarChar(100)
  corrResidentialArea  String?  @map("corr_residential_area") @db.VarChar(100)
  
  // Address - Permanent
  permAddress          String   @map("perm_address") @db.Text
  permState            String   @map("perm_state") @db.VarChar(100)
  permDistrict         String   @map("perm_district") @db.VarChar(100)
  permPincode          String   @map("perm_pincode") @db.VarChar(6)
  permCity             String   @map("perm_city") @db.VarChar(100)
  permResidentialArea  String?  @map("perm_residential_area") @db.VarChar(100)
  
  // Contact Details
  studentMobile        String   @map("student_mobile") @db.VarChar(10)
  studentEmail         String   @map("student_email") @db.VarChar(150)
  parentMobile         String   @map("parent_mobile") @db.VarChar(10)
  parentEmail          String   @map("parent_email") @db.VarChar(150)
  
  // Parent Details
  parentName           String   @map("parent_name") @db.VarChar(150)
  parentMotherName     String   @map("parent_mother_name") @db.VarChar(150)
  annualIncome         Decimal? @map("annual_income") @db.Decimal(12, 2)
  occupation           String   @db.VarChar(100)
  officeAddress        String?  @map("office_address") @db.Text
  
  // Documents & Media
  documents            Json?
  photo                String?  @db.MediumText
  signature            String?  @db.MediumText
  
  // Declaration
  declarationAccepted  Boolean  @default(false) @map("declaration_accepted")
  
  // Status & Timestamps
  status               String   @default("new") @db.VarChar(30)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  
  // Relations
  education            StudentEducation[]
  qualifyingSubjects   StudentQualifyingSubject[]
  subjectsOffered      StudentSubjectOffered[]
  
  @@index([studentEmail])
  @@index([studentMobile])
  @@index([status])
  @@index([createdAt])
  @@map("student_admissions")
}

model StudentEducation {
  id             Int      @id @default(autoincrement())
  admissionId    Int      @map("admission_id")
  examination    String?  @db.VarChar(50)
  board          String?  @db.VarChar(100)
  yearOfPassing  String?  @map("year_of_passing") @db.VarChar(4)
  instituteName  String?  @map("institute_name") @db.VarChar(200)
  seatNumber     String?  @map("seat_number") @db.VarChar(50)
  obtainedMarks  Decimal? @map("obtained_marks") @db.Decimal(8, 2)
  maxMarks       Decimal? @map("max_marks") @db.Decimal(8, 2)
  percentage     Decimal? @db.Decimal(5, 2)
  grade          String?  @db.VarChar(10)
  
  admission StudentAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  
  @@index([admissionId])
  @@map("student_education")
}

model StudentQualifyingSubject {
  id             Int      @id @default(autoincrement())
  admissionId    Int      @map("admission_id")
  subjectName    String?  @map("subject_name") @db.VarChar(150)
  obtainedMarks  Decimal? @map("obtained_marks") @db.Decimal(8, 2)
  maxMarks       Decimal? @map("max_marks") @db.Decimal(8, 2)
  
  admission StudentAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  
  @@index([admissionId])
  @@map("student_qualifying_subjects")
}

model StudentSubjectOffered {
  id           Int      @id @default(autoincrement())
  admissionId  Int      @map("admission_id")
  srNo         Int?     @map("sr_no")
  groupName    String?  @map("group_name") @db.VarChar(150)
  subjectName  String?  @map("subject_name") @db.VarChar(150)
  
  admission StudentAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  
  @@index([admissionId])
  @@map("student_subjects_offered")
}


// ─── Dynamic Website Content ──────────────────────────────────────────────────

model SiteConfig {
  id         Int      @id @default(autoincrement())
  key        String   @unique @db.VarChar(50)
  topbarText String?  @db.Text        @map("topbar_text")
  buttonName String?  @db.VarChar(100) @map("button_name")
  buttonLink String?  @db.VarChar(500) @map("button_link")
  enabled    Boolean  @default(true)
  updatedAt  DateTime @updatedAt      @map("updated_at")

  @@map("site_config")
}

model GalleryMedia {
  id        Int      @id @default(autoincrement())
  type      String   @db.VarChar(10)
  filename  String   @db.VarChar(255)
  url       String   @db.VarChar(500)
  size      Int
  mimeType  String   @db.VarChar(100) @map("mime_type")
  section   String   @db.VarChar(50)
  sortOrder Int      @default(0)      @map("sort_order")
  createdAt DateTime @default(now())  @map("created_at")

  @@index([section])
  @@index([section, sortOrder])
  @@map("gallery_media")
}

model Event {
  id             Int       @id @default(autoincrement())
  title          String    @db.VarChar(255)
  imageUrl       String    @db.VarChar(500) @map("image_url")
  eventDate      DateTime  @map("event_date")
  endDate        DateTime? @map("end_date")
  status         String    @default("active") @db.VarChar(20)
  movedToGallery Boolean   @default(false)   @map("moved_to_gallery")
  createdAt      DateTime  @default(now())   @map("created_at")
  updatedAt      DateTime  @updatedAt        @map("updated_at")

  @@index([status])
  @@index([eventDate])
  @@map("events")
}

model ActivityItem {
  id        Int       @id @default(autoincrement())
  section   String    @db.VarChar(100)
  type      String    @db.VarChar(10)
  url       String    @db.VarChar(500)
  filename  String    @db.VarChar(255)
  heading   String    @db.VarChar(255)
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  sortOrder Int       @default(0)     @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([section])
  @@map("activity_items")
}

model MediaLibrary {
  id           Int        @id @default(autoincrement())
  type         String     @db.VarChar(10)
  filename     String     @db.VarChar(255)
  url          String     @db.VarChar(500)
  thumbnailUrl String?    @db.VarChar(500) @map("thumbnail_url")
  size         Int
  mimeType     String     @db.VarChar(100) @map("mime_type")
  title        String?    @db.VarChar(255)
  altText      String?    @db.VarChar(255) @map("alt_text")
  caption      String?    @db.Text
  uploadedBy   Int?       @map("uploaded_by")
  uploader     AdminUser? @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  tags         String?    @db.Text
  usageCount   Int        @default(0)      @map("usage_count")
  createdAt    DateTime   @default(now())  @map("created_at")
  updatedAt    DateTime   @updatedAt       @map("updated_at")

  @@index([type])
  @@index([createdAt])
  @@map("media_library")
}

model Article {
  id               Int       @id @default(autoincrement())
  section          String    @db.VarChar(50)
  title            String    @db.VarChar(255)
  slug             String    @unique @db.VarChar(255)
  featuredImage    String    @map("featured_image") @db.VarChar(500)
  shortDescription String?   @map("short_description") @db.Text
  content          String    @db.LongText
  additionalImages Json?     @map("additional_images")
  publishedAt      DateTime? @map("published_at")
  eventDate        DateTime? @map("event_date")
  endDate          DateTime? @map("end_date")
  sortOrder        Int       @default(0) @map("sort_order")
  status           String    @default("published") @db.VarChar(20)
  seoTitle         String?   @map("seo_title") @db.VarChar(255)
  seoDescription   String?   @map("seo_description") @db.Text
  seoKeywords      String?   @map("seo_keywords") @db.VarChar(500)
  canonicalUrl     String?   @map("canonical_url") @db.VarChar(500)
  schemaCode       String?   @map("schema_code") @db.LongText
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([section])
  @@index([section, status])
  @@index([section, sortOrder])
  @@index([slug])
  @@map("articles")
}
