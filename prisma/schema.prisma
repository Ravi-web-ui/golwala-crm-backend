generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  email      String   @unique @db.VarChar(150)
  password   String   @db.VarChar(255)
  phone      String?  @db.VarChar(20)
  role       Role     @default(admin)
  createdAt  DateTime @default(now()) @map("created_at")

  leads            Lead[]       @relation("AssignedLeads")
  filters          Filter[]
  permissions      Permission?
  programAssignments ProgramAssignment[]
  activities       Activity[]
  followUps        FollowUp[]
  callLogs         CallLog[]

  @@map("admin_users")
}

model Permission {
  id               Int      @id @default(autoincrement())
  adminId          Int      @unique @map("admin_id")
  canViewLeads     Boolean  @default(true)  @map("can_view_leads")
  canEditLeads     Boolean  @default(true)  @map("can_edit_leads")
  canDeleteLeads   Boolean  @default(false) @map("can_delete_leads")
  canExportLeads   Boolean  @default(false) @map("can_export_leads")
  canViewReports   Boolean  @default(true)  @map("can_view_reports")
  canManageFilters Boolean  @default(true)  @map("can_manage_filters")
  updatedAt        DateTime @updatedAt      @map("updated_at")

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("permissions")
}

// Manager → programs mapping for auto-routing
model ProgramAssignment {
  id       Int    @id @default(autoincrement())
  adminId  Int    @map("admin_id")
  program  String @db.VarChar(255)

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, program])
  @@map("program_assignments")
}

model Lead {
  id           Int        @id @default(autoincrement())
  fullName     String     @map("full_name")     @db.VarChar(150)
  countryCode  String     @default("+91") @map("country_code") @db.VarChar(10)
  phone        String     @db.VarChar(20)
  email        String     @db.VarChar(150)
  city         String?    @db.VarChar(100)
  state        String?    @db.VarChar(100)
  programLevel String?    @map("program_level") @db.VarChar(50)
  program      String?    @db.VarChar(255)
  hearAbout    String?    @map("hear_about")    @db.VarChar(100)
  status       String     @default("new")
  assignedTo   Int?       @map("assigned_to")
  notes        String?    @db.Text
  utmSource    String?    @map("utm_source")    @db.VarChar(150)
  utmMedium    String?    @map("utm_medium")    @db.VarChar(150)
  utmCampaign  String?    @map("utm_campaign")  @db.VarChar(150)
  utmTerm      String?    @map("utm_term")      @db.VarChar(150)
  utmContent   String?    @map("utm_content")   @db.VarChar(150)
  utmName      String?    @map("utm_name")      @db.VarChar(150)
  formSource   String?    @map("form_source")   @db.VarChar(255)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt      @map("updated_at")

  assignedAdmin AdminUser? @relation("AssignedLeads", fields: [assignedTo], references: [id])
  activities    Activity[]
  followUps     FollowUp[]
  callLogs      CallLog[]

  // Indexes for fast filtering with 10k+ leads
  @@index([status])
  @@index([assignedTo])
  @@index([createdAt])
  @@index([phone])
  @@index([programLevel])
  @@index([program])
  @@index([status, assignedTo])
  @@index([status, createdAt])
  @@map("leads")
}

model Activity {
  id        Int          @id @default(autoincrement())
  leadId    Int          @map("lead_id")
  adminId   Int          @map("admin_id")
  type      ActivityType
  note      String?      @db.Text
  createdAt DateTime     @default(now()) @map("created_at")

  lead  Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  admin AdminUser @relation(fields: [adminId], references: [id])

  @@index([leadId])
  @@index([createdAt])
  @@map("activities")
}

model FollowUp {
  id          Int            @id @default(autoincrement())
  leadId      Int            @map("lead_id")
  adminId     Int            @map("admin_id")
  scheduledAt DateTime       @map("scheduled_at")
  note        String?        @db.VarChar(500)
  status      FollowUpStatus @default(pending)
  createdAt   DateTime       @default(now()) @map("created_at")

  lead  Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  admin AdminUser @relation(fields: [adminId], references: [id])

  @@index([leadId])
  @@index([adminId, status, scheduledAt])
  @@map("follow_ups")
}

model CallLog {
  id        Int         @id @default(autoincrement())
  leadId    Int         @map("lead_id")
  adminId   Int         @map("admin_id")
  calledAt  DateTime    @map("called_at")
  duration  Int?        // minutes
  outcome   CallOutcome
  notes     String?     @db.VarChar(500)
  createdAt DateTime    @default(now()) @map("created_at")

  lead  Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  admin AdminUser @relation(fields: [adminId], references: [id])

  @@map("call_logs")
}

model Filter {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  createdBy    Int      @map("created_by")
  filterConfig Json     @map("filter_config")
  isShared     Boolean  @default(false) @map("is_shared")
  createdAt    DateTime @default(now()) @map("created_at")

  admin AdminUser @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("filters")
}

model ContactInquiry {
  id        Int      @id @default(autoincrement())
  fullName  String   @map("full_name")  @db.VarChar(150)
  phone     String?  @db.VarChar(20)
  email     String   @db.VarChar(150)
  program   String?  @db.VarChar(255)
  message   String   @db.Text
  status    String   @default("new")   @db.VarChar(50)
  createdAt DateTime @default(now())   @map("created_at")

  @@map("contact_inquiries")
}

model LeadStatusConfig {
  id        Int      @id @default(autoincrement())
  label     String   @db.VarChar(100)
  value     String   @unique @db.VarChar(100)
  color     String   @db.VarChar(50)
  stage     String   @default("active") @db.VarChar(20)
  order     Int      @default(0)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("lead_status_configs")
}

enum Role {
  super_admin
  admin
  manager
}

enum ActivityType {
  note
  call
  whatsapp
  email
  visit
  status_change
  follow_up
  lead_created
}

enum FollowUpStatus {
  pending
  done
  missed
}

enum CallOutcome {
  answered
  not_answered
  busy
  callback_requested
}
